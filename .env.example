# Copy to .env and edit. .env is git-ignored. Never put real secrets in this example file.

# Optional: require this token on every API/WebSocket request (open the dashboard as http://127.0.0.1:8600/?token=...)
JARVIS_API_TOKEN=change-me-to-a-long-random-string

# Optional: keep data (settings, conversations, reminders) somewhere else
# JARVIS_DATA_DIR=C:\Users\you\jarvis-data

# Telephony: no paid provider credentials are used or needed. Real PSTN calling is disabled by design.

# Optional: web lookups (news, prices, scores, weather). One key is enough; setup.bat adds it for you.
# Only the search words are sent. Free tiers, no card: Tavily (app.tavily.com), Brave, Serper.
# TAVILY_API_KEY=
# BRAVE_API_KEY=
# SERPER_API_KEY=
